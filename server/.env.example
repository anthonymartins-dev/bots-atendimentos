DATABASE_URL=postgres://utilizador:palavra-passe@localhost:5432/bots_atendimento
PORT=3006

# Telegram: token do @BotFather. Sem URL pública, o servidor vai buscar as mensagens (polling).
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODO=polling
# Só para o modo webhook: segredo que o Telegram envia no cabeçalho de cada pedido.
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Instagram (mensagens diretas, Meta)
INSTAGRAM_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=

# Em produção: endereço do site, para a API só aceitar pedidos dele (vários separados por vírgulas)
CORS_ORIGIN=
